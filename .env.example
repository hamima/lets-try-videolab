# Template for docker-compose.yml's backend service. Copy to .env (gitignored)
# and fill in real values — .env itself is never committed.
#
#   cp .env.example .env

# Required — sign-in 500s without it (see backend/settings.py's load()).
# Must match the OAuth Client ID's authorized JavaScript origins in Google
# Cloud Console (the frontend's deployed origin) — see docs/authentication.md.
GOOGLE_CLIENT_ID=

# Comma-separated list of exact origins allowed to call the API cross-origin
# (e.g. the frontend's deployed URL). Leave empty for same-origin-only setups
# (no CORS middleware gets added — see backend/tasks.py's ALLOWED_ORIGINS).
ALLOWED_ORIGINS=

# Optional — pipeline API keys. These can also be left unset here and
# configured later through the Settings UI instead (written to
# settings.json on the persistent /data volume, so they survive container
# recreation either way).
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
RUNPOD_URL=
