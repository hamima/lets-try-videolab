{
  // This project deploys as a Cloudflare Worker with static assets (the
  // "Workers Builds" dashboard flow), NOT classic Cloudflare Pages —
  // `pages_build_output_dir` (an earlier, wrong attempt at this file) is a
  // Pages-only config key and does nothing here. There's no actual Worker
  // script (no `main`) — this is a pure static SPA, served entirely via the
  // `assets` block below.
  //
  // Dashboard build settings (Settings → Build):
  //   Root directory:  frontend
  //   Build command:   npm run build
  //   Deploy command:  npx wrangler deploy
  //   Preview command: npx wrangler versions upload
  //
  // "name" must match whatever this project is named in the Cloudflare
  // dashboard exactly (confirmed via the deploy log's API path:
  // /workers/scripts/try-videolab/...).
  "name": "try-videolab",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    // Requests that don't match a built static asset get index.html with a
    // 200 (not a 404) — lets the client-side router handle them. Do NOT
    // also add a catch-all `/* /index.html 200` rule to a _redirects file
    // alongside this: Cloudflare's redirect validator rejects it as an
    // "infinite loop" (error 100324) since /* also matches /index.html
    // itself — this not_found_handling setting is the correct, non-redirect
    // mechanism for SPA fallback on Workers static assets.
    "not_found_handling": "single-page-application"
  }
}
