# Production build defaults — loaded automatically by `vite build` (default
# mode: production). Committed: values here are non-secret (everything is
# inlined into the public client bundle regardless). For anything that must
# differ per machine/deploy and shouldn't be committed, use
# .env.production.local instead (gitignored, same *.local convention as
# .env.local) — it overrides the values below.

# Never run a production build with either mock flag on.
VITE_MOCK=false
VITE_MOCK_TASKS=false

# Backend address for the pipeline API. Vite inlines this at build time, not
# runtime (see README.md's "VITE_API_URL" section) — a build is locked to
# whatever this was set to when `npm run build` ran.
#
# Leave unset (commented out) if production serves the built frontend and
# backend/tasks.py from the same origin behind a reverse proxy that forwards
# /tasks/* — the default relative '/tasks' path then works exactly as in dev.
# Set it if the frontend and backend are on different hosts.
# VITE_API_URL=https://api.yourdomain.com

# Google OAuth Client ID used by the Sign-In page (see docs/authentication.md).
# OAuth client IDs are tied to a set of authorized JavaScript origins in
# Google Cloud Console — the dev Client ID in .env.local is authorized for
# http://localhost:5173 only. Register a separate Client ID for your
# production origin (or add that origin to the existing one) and set it here;
# it must also match GOOGLE_CLIENT_ID in the backend's settings.json for that
# environment.
# VITE_GOOGLE_CLIENT_ID=
