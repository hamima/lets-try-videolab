{
  "1": {
    "_meta": { "title": "Load Wan 2.1 I2V Model" },
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "Wan2_1-I2V-14B-480P_fp8_e4m3fn.safetensors",
      "quantization": "fp8_e4m3fn",
      "load_device": "main_device"
    }
  },
  "2": {
    "_meta": { "title": "Load Wan VAE" },
    "class_type": "WanVideoVAELoader",
    "inputs": {
      "vae_name": "Wan_2.1_VAE.safetensors"
    }
  },
  "3": {
    "_meta": { "title": "Load CLIP / Text Encoder" },
    "class_type": "WanVideoCLIPLoader",
    "inputs": {
      "clip_name": "umt5-xxl-enc-bf16.safetensors",
      "type": "umt5"
    }
  },
  "4": {
    "_meta": { "title": "Encode Prompt" },
    "class_type": "WanVideoTextEncode",
    "inputs": {
      "clip": ["3", 0],
      "positive_prompt": "__PROMPT__",
      "negative_prompt": "bad quality, blurry, distorted, watermark, text, logo, static, frozen, no motion"
    }
  },
  "5": {
    "_meta": { "title": "Load Input Image" },
    "class_type": "LoadImage",
    "inputs": {
      "image": "__IMAGE_FILENAME__"
    }
  },
  "6": {
    "_meta": { "title": "Image-to-Video Conditioning" },
    "class_type": "WanVideoImageToVideoConditioningEncode",
    "inputs": {
      "positive": ["4", 0],
      "negative": ["4", 1],
      "vae": ["2", 0],
      "image": ["5", 0]
    }
  },
  "7": {
    "_meta": { "title": "Empty Latent Video" },
    "class_type": "EmptyWanLatentVideo",
    "inputs": {
      "batch_size": 1,
      "height": 480,
      "width": 832,
      "length": __FRAME_COUNT__
    }
  },
  "8": {
    "_meta": { "title": "Wan Video Sampler" },
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["6", 0],
      "negative": ["6", 1],
      "latent_video": ["7", 0],
      "steps": 20,
      "cfg": 6.0,
      "seed": 42,
      "scheduler": "unipc",
      "denoise": 1.0,
      "force_offload": true
    }
  },
  "9": {
    "_meta": { "title": "Decode Frames" },
    "class_type": "WanVideoVAEDecode",
    "inputs": {
      "vae": ["2", 0],
      "samples": ["8", 0],
      "enable_vae_tiling": true,
      "tile_sample_min_height": 272,
      "tile_sample_min_width": 272,
      "tile_overlap_factor_height": 0.2,
      "tile_overlap_factor_width": 0.2
    }
  },
  "10": {
    "_meta": { "title": "Save Video" },
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["9", 0],
      "frame_rate": 24,
      "loop_count": 0,
      "filename_prefix": "wan_i2v",
      "format": "video/h264-mp4",
      "save_output": true,
      "pingpong": false
    }
  }
}
